{
    "fullUrl":"urn:uuid:{{ID}}",
    "resource":{
        "resourceType": "CarePlan",
        "id":"{{ID}}",
        {% assign entries = carePlan.entry | to_array -%}
        "identifier":
        [
            {% assign ids = carePlan.id | to_array -%}
            {% comment %}
                Direct act entries become activities on this CarePlan instead of separate
                resources. Include their ids so Entry References can find the CarePlan.
            {% endcomment %}
            {% for entry in entries -%}
                {% if entry.act -%}
                    {% assign actIds = entry.act.id | to_array -%}
                    {% assign ids = ids | concat: actIds -%}
                {% endif -%}
            {% endfor -%}
            {% for id in ids -%}
                {% include 'DataType/Identifier', Identifier: id -%}
            {% endfor -%}
        ],
        "status": "unknown",
        "intent": "proposal",
        "subject": {
            "reference": "{{ patientReference }}",
        },
        "activity":[
            {% for entry in entries %}
                {% assign act = entry.act %}
                {% comment %} Other entry types are handled in `Entry/PlanOfTreatment/entry` {% endcomment %}
                {% if act %}
                    {
                        "detail": {
                            {% if act.moodCode == "ARQ" or act.moodCode == "APT" or entry.encounter %}
                                "kind": "Appointment",
                            {% else %}
                                "kind": "Task",
                            {% endif %}
                            "code": { {% include 'DataType/CodeableConcept', CodeableConcept: act.code %} },
                            {% assign reasons = act.entryRelationship | to_array | where: "typeCode", "RSON" %}
                            "reasonCode": [
                                {% for reason in reasons %}
                                    { {% include 'DataType/CodeableConcept', CodeableConcept: reason.observation.value %} },
                                {% endfor %}
                            ],
                            {% if act.effectiveTime %}
                                "status": "scheduled",
                            {% else %}
                                "status": "not-started",
                            {% endif %}
                            {% comment %} planned activities use scheduledString instead of scheduledDateTime {% endcomment %}
                            {% comment %} Using raw filter to prevent the output from Utils/EffectiveTime from being double-encoded because it outputs JSON {% endcomment %}
                            {% capture time %}{% include 'Utils/EffectiveTime', effectiveTime: act.effectiveTime, timeType: "scheduled" %}{% endcapture %}
                            {{ time |  replace_first: "DateTime", "String" | raw }}
                        }
                    },
                {% endif %}
            {% endfor %}
        ]
    },
},
