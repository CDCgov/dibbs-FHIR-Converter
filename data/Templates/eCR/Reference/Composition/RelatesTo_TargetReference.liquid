{
    "resource":{
        "resourceType": "Composition",
        "id":"{{ ID }}",
        "relatesTo":
        [
            {
                {% if relatedDOC.typeCode and relatedDOC.typeCode == "RPLC" -%}
                    "code": "replaces",
                {% endif -%}                
                {% if relatedDOC.parentDocument -%}
                    {% if relatedDOC.parentDocument.id and relatedDOC.parentDocument.id.root -%}

                        "targetReference":
                        {
                            {% if relatedDOC.parentDocument.versionNumber.value -%}
                                "reference":"Composition/{{ relatedDOC.parentDocument.id.root }}/_history/{{ relatedDOC.parentDocument.versionNumber.value }}",
                            {% else -%}
                                "reference":"Composition/{{ relatedDOC.parentDocument.id.root }}",
                            {% endif -%}
                        },
                    {% endif -%}
                {% endif -%}

            },
        ],
    },
},
